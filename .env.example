# ============================================================
# ImmoManager — Variables d'environnement Docker
# ============================================================

# Port HTTP public de l'application
APP_PORT=80
APP_URL=http://localhost

# Base de données
DB_DATABASE=immomanager
DB_USERNAME=immomanager
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
DB_PORT=3306

# Application
APP_ENV=production
APP_DEBUG=false
# Générer avec : php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# Email (mailpit, smtp, log...)
MAIL_MAILER=log

# URL du frontend pour les redirections (reset password)
FRONTEND_URL=http://localhost
